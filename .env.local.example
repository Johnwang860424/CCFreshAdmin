# 複製此檔為 .env.local 並填入真實值（.env.local 已被 .gitignore 忽略）

# NextAuth 用來簽署 session 的密鑰，產生方式：npx auth secret 或 openssl rand -base64 32
AUTH_SECRET=

# Google OAuth 憑證（Google Cloud Console > APIs & Services > Credentials）
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 允許登入的 Google 帳號白名單，逗號分隔；預設拒絕：留空代表沒有任何帳號可登入
# 例：ALLOWED_EMAILS=alice@example.com,bob@example.com
ALLOWED_EMAILS=

# Cloudinary 圖片上傳（Cloudinary Console > Settings > API Keys）
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 前台快取更新：編輯資料後通知前台 revalidate。
# ADMIN_SECRET_TOKEN 同時保護本站 /api/revalidate（前台下單扣庫存後回敲）
FRONTEND_URL=
ADMIN_SECRET_TOKEN=

# Neon Postgres 連線字串（Neon Console > Connection Details，建議用 pooled 連線）
DATABASE_URL=